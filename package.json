{
  "name": "aruna-digital-web",
  "version": "1.0.0",
  "private": true,
  "description": "Website company Aruna Digital — React SSR + Express + MongoDB, siap deploy ke Google Cloud Run",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "framer-motion": "^11.11.17",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^14.1.4",
    "mongoose": "^8.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0",
    "sanitize-html": "^2.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11"
  }
}
