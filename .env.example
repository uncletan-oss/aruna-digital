# Salin ke .env untuk development lokal. Di Cloud Run, isi lewat Secret Manager / env vars.

# Koneksi MongoDB (MongoDB Atlas disarankan untuk Cloud Run)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/arunadigital?retryWrites=true&w=majority

# URL publik situs (dipakai untuk canonical, sitemap, Open Graph)
SITE_URL=https://aruna-digital.com

# Rahasia penandatangan sesi admin — WAJIB di production, minimal 32 karakter acak
# Buat dengan: openssl rand -base64 48
JWT_SECRET=

# Akun owner CMS pertama (dibuat otomatis saat server start jika belum ada)
ADMIN_EMAIL=admin@aruna-digital.com
ADMIN_PASSWORD=

# Opsional
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Cloud Run mengisi PORT otomatis (default 8080)
# PORT=8080
